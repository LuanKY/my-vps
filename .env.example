# ==============================================================================
# MyVPS Configuration
# Duplicate this file as '.env' and adjust the variables to your preference:
# cp .env.example .env
# ==============================================================================

# External port mapping on the host (Default: 8000)
PORT=8000

# Name of this server/VPS displayed in the dashboard header and browser tab
SERVER_NAME=MyVPS

# Real-time WebSocket update interval in seconds (Default: 3.0)
UPDATE_INTERVAL=3.0

# Optional HTTP Basic Authentication
# Leave empty to keep access open (recommended if you are using Tailscale, VPN or an authenticated reverse proxy)
# Set username and password to secure the dashboard and API directly:
AUTH_USERNAME=
AUTH_PASSWORD=
